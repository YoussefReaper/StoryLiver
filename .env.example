# ---------------------------------------------------------------------------
# StoryLiver — copy to .env and fill in. The OpenAI key is the only required
# line to go live. A paid Tier-1 key ($5+ spent) is enough - see "Models" in
# the README for why Organization Verification isn't a blocker here.
# ---------------------------------------------------------------------------

# Required. Powers World Master, Narrator, NPC minds and Director on GPT-5.4
# nano/mini, Deep Prose on GPT-5.1, by default (see backend/config.py). Get
# one at platform.openai.com/api-keys.
OPENAI_API_KEY=sk-...

# Optional: point the OpenAI client at a different base URL (OpenRouter,
# Groq, vLLM, a local server, ...). Leave unset for the default OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: run some or all roles on Claude instead. Only used for MODELS
# entries that start with "claude-" - set one below to a claude-* id (Haiku
# 4.5 for the cheap/frequent roles, Sonnet 5 or better for Deep Prose) and
# the matching call routes through the native Anthropic Messages API.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: per-role model routing. Defaults shown - GPT-5.4 nano for the
# structured/mechanical roles (World Master, Director), GPT-5.4 mini for the
# player-facing text (NPC minds, standard Narrator), GPT-5.1 for the opt-in
# Deep Prose narrator. See README "Models" and "Pricing" for the real
# per-action cost math and model-access research behind these choices.
# STORYLIVER_MODEL_WM=gpt-5.4-nano
# STORYLIVER_MODEL_NARRATOR=gpt-5.4-mini
# STORYLIVER_MODEL_NARRATOR_PREMIUM=gpt-5.1
# STORYLIVER_MODEL_NPC=gpt-5.4-mini
# STORYLIVER_MODEL_DIRECTOR=gpt-5.4-nano

# Optional: economy. Free actions per day, starting Mana, and the hard
# per-user daily spend rail that protects you from a runaway loop.
# STORYLIVER_FREE_DAILY_MANA=40
# STORYLIVER_STARTING_MANA=40
# STORYLIVER_DAILY_COST_CAP_USD=1.00

# auto (default) = live when a key is present, offline stub when not.
# mock = force the offline stub. live = force real calls.
# STORYLIVER_LLM_MODE=auto

# --- Payments (PayPal) ------------------------------------------------------
# Unset = Mana purchases use a dev-only instant grant, no money moves. Set
# both to go live - create an app at developer.paypal.com under the PayPal
# account you want paid (this deployment's default account is
# youssefmohammedaraby123@gmail.com); that dashboard gives you the client id
# and secret below. CLIENT_ID is also sent to the browser (it's the public
# half, meant for the PayPal JS SDK tag) - CLIENT_SECRET never leaves the
# server.
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_ENV=sandbox            # sandbox while testing; "live" to take real money
# PAYPAL_BUSINESS_EMAIL=youssefmohammedaraby123@gmail.com   # display only, not a credential

# --- Full version -----------------------------------------------------------
# Realtime layer. Unset = in-process (correct for ONE worker only).
# Set an Upstash/Redis URL the moment you run more than one.
# REDIS_URL=rediss://default:...@...upstash.io:6379

# Comma-separated allowed origins when the player is served from another host
# (e.g. Cloudflare Pages). Defaults to *.
# STORYLIVER_CORS=https://storyliver.pages.dev

# Rooms
# STORYLIVER_MAX_PLAYERS=6
# STORYLIVER_FREE_FRIENDS=5
# STORYLIVER_MAX_ALLOWANCE_STACK=5
# STORYLIVER_PRESENCE_TTL=45

# Optional paid studio voice. Reading aloud on the player's own device is
# always available and always free; this is only for a server-side TTS model.
# STORYLIVER_TTS_MODEL=gpt-4o-mini-tts
# STORYLIVER_TTS_VOICE=onyx
# STORYLIVER_TTS_MANA=2

# --- Accounts ---------------------------------------------------------------
# Sessions are server-side rows keyed by a hashed token in an HttpOnly cookie.
# Set this to 1 to force the Secure flag when you terminate TLS upstream (a
# reverse proxy) and the app itself only ever sees plain HTTP.
# STORYLIVER_FORCE_SECURE_COOKIE=1

# --- Live canon research (World Bootstrap) ----------------------------------
# "Continue a real world" reads Wikipedia and Fandom before building. Disabled
# automatically under STORYLIVER_LLM_MODE=mock so the test suites stay offline.
# STORYLIVER_RESEARCH=off
# Wikimedia asks for contact details in the User-Agent - set this in production.
# STORYLIVER_RESEARCH_CONTACT=https://your-site.example/storyliver
# STORYLIVER_RESEARCH_TIMEOUT=8

# --- Durable storage (survives a free host with no persistent disk) --------
# Render's free web service (and most free trial tiers) wipes local storage on
# every spin-down or redeploy. Set MONGODB_URI and StoryLiver will back the
# live SQLite database up to MongoDB on a timer and on graceful shutdown, and
# restore it automatically the moment a fresh container boots with an empty
# filesystem. Off by default - SQLite alone is all you need for local dev or
# any host that actually gives you a disk.
#
# A free MongoDB Atlas M0 cluster (atlas.mongodb.com) works well for this and
# needs no card. Use the "mongodb+srv://" connection string it gives you.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
# MONGODB_DB=storyliver
# STORYLIVER_BACKUP_INTERVAL=300
